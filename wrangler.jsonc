{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whoami",
  "compatibility_date": "2026-09-18",
  "main": "./src/index.tsx",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false }
  },
  "routes": [
    {
      "pattern": "wardak.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.wardak.dev",
      "custom_domain": true
    }
  ]
}
